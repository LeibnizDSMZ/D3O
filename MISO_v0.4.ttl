@prefix : <https://purl.dsmz.de/schema/MISO_> .
@prefix BTO: <http://purl.obolibrary.org/obo/BTO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ENVO: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix NCIT: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix OMIT: <http://purl.obolibrary.org/obo/OMIT_> .
@prefix PATO: <http://purl.obolibrary.org/obo/PATO_> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix FOODON: <http://purl.obolibrary.org/obo/FOODON_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@base <https://purl.dsmz.de/schema/MISO_> .

<https://purl.dsmz.de/schema/MISO_> rdf:type owl:Ontology ;
                                    dcterms:contributor "Andrey Yurkov" ,
                                                        "Lorenz Christian Reimer" ,
                                                        "Sabine Gronow" ;
                                    dcterms:creator "Julia Koblitz" ;
                                    dcterms:description "This ontology aims to classify and tag microbial isolation sources, which are often only provided as free-text commentaries, to improve their accessibility and usability."@en ;
                                    rdfs:label "Microbial Isolation Source Ontology (MISO)"@en ;
                                    owl:versionInfo 0.3 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym
oboInOwl:hasBroadSynonym rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym
oboInOwl:hasNarrowSynonym rdf:type owl:AnnotationProperty .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#description
rdf:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#altLabel
rdfs:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#description
rdfs:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#narrower
skos:narrower rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  https://purl.dsmz.de/schema/MISO_1
<https://purl.dsmz.de/schema/MISO_1> rdf:type owl:Class ;
                                     rdfs:subClassOf owl:Thing ;
                                     rdfs:description "Engineered environments are human-made environments, such as bioreactors, bioremediation sites, and food production facilities."@en ;
                                     rdfs:label "Engineered"@en ;
                                     skos:example "anaerobic fixed-bed reactor digesting sour whey" .


###  https://purl.dsmz.de/schema/MISO_1_1
<https://purl.dsmz.de/schema/MISO_1_1> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1> ;
                                       rdfs:description "Agricultural environments include fields, gardens, groves, plantations, and vineyards."@en ;
                                       rdfs:label "Agriculture"@en ;
                                       skos:example "soil, Drentse A agricultural research area" .


###  https://purl.dsmz.de/schema/MISO_1_10
<https://purl.dsmz.de/schema/MISO_1_10> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1> ;
                                        rdfs:description "Waste environments include landfills, solid waste, and waste gases."@en ;
                                        rdfs:label "Waste"@en ;
                                        rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002264> ;
                                        skos:example "fish farm effluent" .


###  https://purl.dsmz.de/schema/MISO_1_10_307
<https://purl.dsmz.de/schema/MISO_1_10_307> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                            rdfs:description "Waste from households, such as kitchen refuse."@en ;
                                            rdfs:label "Domestic waste"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_01000372> ;
                                            skos:example "decomposed kitchen refuse" .


###  https://purl.dsmz.de/schema/MISO_1_10_308
<https://purl.dsmz.de/schema/MISO_1_10_308> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                            rdfs:description "Dust and ash from industrial processes such as burning or grinding materials."@en ;
                                            rdfs:label "Dust (Ash)"@en ;
                                            skos:example "sawdust of Ulmus nigra" .


###  https://purl.dsmz.de/schema/MISO_1_10_309
<https://purl.dsmz.de/schema/MISO_1_10_309> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                            rdfs:description "Waste produced by industrial processes."@en ;
                                            rdfs:label "Industrial waste"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002267> ;
                                            skos:example "soil, industrial waste deposit" .


###  https://purl.dsmz.de/schema/MISO_1_10_310
<https://purl.dsmz.de/schema/MISO_1_10_310> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                            rdfs:description "Solid material that is treated as waste." ;
                                            rdfs:label "Solid waste"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_02000155> ;
                                            skos:example "municipal dumping ground" .


###  https://purl.dsmz.de/schema/MISO_1_10_311
<https://purl.dsmz.de/schema/MISO_1_10_311> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                            rdfs:description "Gases that are treated as waste."@en ;
                                            rdfs:label "Waste gas"@en ;
                                            skos:example "compost biofilter for waste gas purification of animal rendering plant emissions" .


###  https://purl.dsmz.de/schema/MISO_1_10_312
<https://purl.dsmz.de/schema/MISO_1_10_312> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                            rdfs:description "Water that has been used and contains waste."@en ;
                                            rdfs:label "Wastewater"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002001> ;
                                            skos:example "copper mine effluent" .


###  https://purl.dsmz.de/schema/MISO_1_10_56
<https://purl.dsmz.de/schema/MISO_1_10_56> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                           rdf:description "Landfill sites, where waste is disposed of."@en ;
                                           rdfs:label "Landfill"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000533> ;
                                           skos:example "urban air and municipal landfill sites" .


###  https://purl.dsmz.de/schema/MISO_1_10_57
<https://purl.dsmz.de/schema/MISO_1_10_57> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                           rdfs:description "Solid waste from animals, such as manure."@en ;
                                           rdfs:label "Solid animal waste"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002276> ;
                                           skos:example "anaerobic digestor operated with solid meat waste" .


###  https://purl.dsmz.de/schema/MISO_1_10_58
<https://purl.dsmz.de/schema/MISO_1_10_58> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                           rdfs:description "Solid waste from plants, such as leaves or stems."@en ;
                                           rdfs:label "Solid plant waste"@en ;
                                           skos:example "alcaline compost of manure with grass and rice straw" .


###  https://purl.dsmz.de/schema/MISO_1_10_61
<https://purl.dsmz.de/schema/MISO_1_10_61> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                           rdfs:description "Sludge that has been treated with microorganisms to break down waste."@en ;
                                           rdfs:label "Activated sludge"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002046> ;
                                           skos:example "activated sludge of the municipal sewage treatment plant Münster-Coerde" .


###  https://purl.dsmz.de/schema/MISO_1_10_62
<https://purl.dsmz.de/schema/MISO_1_10_62> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ,
                                                           <https://purl.dsmz.de/schema/MISO_2_14> ;
                                           rdfs:description "Water that is found in coalbeds."@en ;
                                           rdfs:label "Coalbed water"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002206> ;
                                           skos:example "coal formation water" .


###  https://purl.dsmz.de/schema/MISO_1_10_63
<https://purl.dsmz.de/schema/MISO_1_10_63> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ,
                                                           <https://purl.dsmz.de/schema/MISO_2_14> ;
                                           rdfs:description "Wastewater from industrial processes."@en ;
                                           rdfs:label "Industrial wastewater"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_01000964> ;
                                           skos:example "effluent drain in a glass-manufacturing plant" .


###  https://purl.dsmz.de/schema/MISO_1_10_64
<https://purl.dsmz.de/schema/MISO_1_10_64> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ;
                                           rdfs:description "Sludge that is produced during sewage treatment."@en ;
                                           rdfs:label "Sewage sludge"@en ;
                                           skos:example "horse manure and sewage sludge of a piggery" .


###  https://purl.dsmz.de/schema/MISO_1_10_65
<https://purl.dsmz.de/schema/MISO_1_10_65> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_10> ,
                                                           <https://purl.dsmz.de/schema/MISO_2_14> ;
                                           rdfs:description "Wastewater treatment plants."@en ;
                                           rdfs:label "Water treatment plant"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002043> ;
                                           skos:example "activated sludge of the municipal sewage treatment plant Münster-Coerde" .


###  https://purl.dsmz.de/schema/MISO_1_11
<https://purl.dsmz.de/schema/MISO_1_11> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1> ;
                                        rdfs:description "Engineered environments that do not fit into the other categories."@en ;
                                        rdfs:label "Other engineered environment"@en ;
                                        skos:example "cathodic chamber of perchlorate reducing enrichment" .


###  https://purl.dsmz.de/schema/MISO_1_11_313
