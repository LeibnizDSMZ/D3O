                                           rdfs:description "A greenhouse is a building with glass walls and roof, providing regulated climatic conditions, used for growing plants."@en ;
                                           rdfs:label "Greenhouse"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_03600087> ;
                                           skos:example "greenhouse soil cultivated with cucumber" .


