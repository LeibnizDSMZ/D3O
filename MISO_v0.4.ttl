                                         skos:example "soil of sugar cane plantation" .


###  https://purl.dsmz.de/schema/MISO_1_1_7
<https://purl.dsmz.de/schema/MISO_1_1_7> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_1> ;
                                         rdfs:description "A place where grapes are grown for making wine, raisins or table grapes."@en ;
                                         rdfs:label "Vineyard"@en ;
                                         rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000116> ;
                                         skos:example "vineyard soil" .


###  https://purl.dsmz.de/schema/MISO_1_2
<https://purl.dsmz.de/schema/MISO_1_2> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1> ;
                                       rdfs:description "Biodegradation environments are sites where biodegradation processes occur, such as composting, anaerobic digestors, and bioreactors."@en ;
                                       rdfs:label "Biodegradation"@en ;
                                       rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_06105014> ;
                                       skos:example "yeast fermentation process" .


###  https://purl.dsmz.de/schema/MISO_1_2_12
<https://purl.dsmz.de/schema/MISO_1_2_12> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_2> ;
                                          rdfs:description "Garden waste that is disposed of."@en ;
                                          rdfs:label "Garden dump"@en ;
                                          skos:example "compost heap of a private garden" .


###  https://purl.dsmz.de/schema/MISO_1_2_333
<https://purl.dsmz.de/schema/MISO_1_2_333> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_2> ;
                                           rdfs:description "Material that is decomposing, such as compost."@en ;
                                           rdfs:label "Decomposing material"@en ;
                                           skos:example "compost heap of a private garden" .


###  https://purl.dsmz.de/schema/MISO_1_2_8
<https://purl.dsmz.de/schema/MISO_1_2_8> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_2> ;
                                         rdfs:description "Anaerobic digestors are bioreactors that use anaerobic microorganisms to break down organic material."@en ;
                                         rdfs:label "Anaerobic digestor"@en ;
                                         skos:example "mixed culture growing on glycolate, originally  obtained  from a pond receiving effluent from an anaerobic solids digester" .


###  https://purl.dsmz.de/schema/MISO_1_2_9
<https://purl.dsmz.de/schema/MISO_1_2_9> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_2> ;
                                         rdfs:description "Composting environments, where organic material is decomposed."@en ;
                                         rdfs:label "Composting"@en ;
                                         rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002170> ;
                                         skos:example "matured compost after the sieving process from the compost plant Coerde" .


###  https://purl.dsmz.de/schema/MISO_1_3
<https://purl.dsmz.de/schema/MISO_1_3> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1> ;
                                       rdfs:description "Bioreactors are vessels in which biological processes are carried out, such as fermentation or biodegradation."@en ;
                                       rdfs:label "Bioreactor"@en ;
                                       rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002123> ;
                                       skos:example "bioleaching reactor" .


###  https://purl.dsmz.de/schema/MISO_1_4
<https://purl.dsmz.de/schema/MISO_1_4> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1> ;
                                       rdfs:description "Bioremediation environments are sites where bioremediation processes occur, such as bioreactors, biopiles, and biostimulation sites."@en ;
                                       rdfs:label "Bioremediation"@en ;
                                       rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_02000176> ;
                                       skos:example "sulfidogenic synthesis-gas-fed bioreactor used for remediation of wastewater from a zinc smelter" .


###  https://purl.dsmz.de/schema/MISO_1_4_15
<https://purl.dsmz.de/schema/MISO_1_4_15> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_4> ;
                                          rdfs:description "Ex situ bioremediation environments are sites where bioremediation processes occur outside of the original site of contamination."@en ;
                                          rdfs:label "Ex situ"@en ;
                                          skos:example "biopile for the treatment of oil-contaminated soil" .


###  https://purl.dsmz.de/schema/MISO_1_4_16
