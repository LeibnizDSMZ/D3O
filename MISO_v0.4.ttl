###  https://purl.dsmz.de/schema/MISO_2_17_102
<https://purl.dsmz.de/schema/MISO_2_17_102> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:description "A core sample is a cylindrical section of material extracted from a solid or semi-solid environment, typically through drilling or coring techniques. Core samples can originate from various substrates, including ice sheets, glaciers, deep-sea sediments, hydrothermal vents, oil-bearing rock formations, the planetary outer layer and karst deposits. They are used for analyzing past climate conditions, geochemical compositions, biological communities, and resource exploration."@en ;
                                            rdfs:label "Core sample"@en ;
                                            skos:example "core sample from 2.7 km depth" .


