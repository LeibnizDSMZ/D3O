###  https://purl.dsmz.de/schema/MISO_2_17_107
<https://purl.dsmz.de/schema/MISO_2_17_107> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:description "A large open area of country covered with grass, especially one used for grazing."@en ;
                                            rdfs:label "Grassland"@en ;
                                            skos:example "clay from grass field" .


###  https://purl.dsmz.de/schema/MISO_2_17_108
<https://purl.dsmz.de/schema/MISO_2_17_108> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_14> ,
                                                            <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:description "Mud is a mixture of water and some combination of soil, silt, and clay."@en ;
                                            rdfs:label "Mud (Sludge)"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_01000001> ;
                                            skos:example "estuarine mud" .


###  https://purl.dsmz.de/schema/MISO_2_17_109
<https://purl.dsmz.de/schema/MISO_2_17_109> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:description "Permafrost is ground that remains frozen for two or more consecutive years."@en ;
                                            rdfs:label "Permafrost"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000134> ;
                                            skos:example "permafrost core of 9 m depth" .


###  https://purl.dsmz.de/schema/MISO_2_17_110
<https://purl.dsmz.de/schema/MISO_2_17_110> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:altLabel "Saline marsh"@en ;
                                            rdfs:description "A salt marsh is a coastal ecosystem in the upper coastal intertidal zone between land and open saltwater or brackish water that is regularly flooded by the tides."@en ;
                                            rdfs:label "Salt marsh"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000054> ;
                                            skos:example "surface of degrading salt marsh cord grass, Spartina alterniflora" .


###  https://purl.dsmz.de/schema/MISO_2_17_111
<https://purl.dsmz.de/schema/MISO_2_17_111> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:altLabel "Sand"@en ;
                                            rdfs:description "Particulate environments which is dominated by particles of sand with only minor proportions of other substances."@en ;
                                            rdfs:label "Sandy"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_01000017> ;
                                            skos:example "sea sand" .


###  https://purl.dsmz.de/schema/MISO_2_17_112
<https://purl.dsmz.de/schema/MISO_2_17_112> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:description "Sediment is a naturally occurring material that is broken down by processes of weathering and erosion, and is subsequently transported by the action of wind, water, or ice, and/or by the force of gravity acting on the particles."@en ;
                                            rdfs:label "Sediment"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00002007> ;
                                            skos:example "bottom sediments" .


###  https://purl.dsmz.de/schema/MISO_2_17_113
<https://purl.dsmz.de/schema/MISO_2_17_113> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:description "Soil is a mixture of organic matter, minerals, gases, liquids, and organisms that together support life."@en ;
                                            rdfs:label "Soil"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00001998> ;
                                            skos:example "biological soil crusts" .


###  https://purl.dsmz.de/schema/MISO_2_17_114
<https://purl.dsmz.de/schema/MISO_2_17_114> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_14> ,
                                                            <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:altLabel "Mudflat"@en ;
                                            rdfs:description "A tidal flat is a coastal wetland that forms when mud is deposited by tides or rivers."@en ;
                                            rdfs:label "Tidal flat"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000241> ;
                                            skos:example "tidal flat sediment sample collected from the shore" .


###  https://purl.dsmz.de/schema/MISO_2_17_115
