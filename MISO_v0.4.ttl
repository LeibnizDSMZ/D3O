                                            rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_2_17> ;
                                            rdfs:altLabel "Tundra soil"@en ;
                                            rdfs:description "A tundra is a biome where the tree growth is hindered by low temperatures and short growing seasons."@en ;
                                            rdfs:label "Tundra"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_01001370> ;
                                            skos:example "tundra soil from a wind-exposed mountain ridge" .


