                                           rdfs:description "City parks and other urban green spaces."@en ;
                                           rdfs:label "Park (City)"@en ;
                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000562> .


###  https://purl.dsmz.de/schema/MISO_1_1_354
