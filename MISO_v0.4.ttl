###  https://purl.dsmz.de/schema/MISO_1_1_1
<https://purl.dsmz.de/schema/MISO_1_1_1> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_1> ;
                                         rdfs:description "Fields used for agriculture."@en ;
                                         rdfs:label "Field"@en ;
                                         rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000114> ;
                                         skos:example "soil of ginseng field" .


###  https://purl.dsmz.de/schema/MISO_1_1_2
<https://purl.dsmz.de/schema/MISO_1_1_2> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_1> ;
                                         rdfs:description "Gardens, such as vegetable gardens or flower gardens."@en ;
                                         rdfs:label "Garden"@en ;
                                         rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000011> ;
                                         skos:example "water from eutrophic garden pond" .


###  https://purl.dsmz.de/schema/MISO_1_1_3
<https://purl.dsmz.de/schema/MISO_1_1_3> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_1_1> ;
                                         rdfs:description "Groves and orchards, such as apple orchards."@en ;
                                         rdfs:label "Grove (Orchard)"@en ;
                                         rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_00000115> ;
                                         skos:example "bulk soil of a temperate orchard" .


###  https://purl.dsmz.de/schema/MISO_1_1_303
<https://purl.dsmz.de/schema/MISO_1_1_303> rdf:type owl:Class ;
