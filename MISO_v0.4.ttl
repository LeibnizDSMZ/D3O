                                        rdfs:subClassOf <https://purl.dsmz.de/schema/MISO_3> ;
                                        rdfs:description "Disease is a particular abnormal condition that negatively affects the structure or function of part or all of an organism, and that is not due to any immediate external injury."@en ;
                                        rdfs:label "Disease"@en ;
                                        rdfs:seeAlso NCIT:C2991 ;
                                        skos:example "leaf sheath of sugar cane and pink sugar-cane mealy bug (Saccharicoccus  sacchari)" .


